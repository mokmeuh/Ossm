{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ossm-remote-2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "assets": { "directory": "./static", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionBroker" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionBroker"] }],
  "vars": { "SESSION_TTL_SECONDS": "3600" }
  // Set ADMIN_TOKEN with: wrangler secret put ADMIN_TOKEN
}
